#cloud-config
autoinstall:
  version: 1

  locale: de_CH.UTF-8

  keyboard:
    layout: ch

  timezone: Europe/Zurich

  identity:
    hostname: llmengws
    username: ubuntu
    password: "$6$jr7iRqqy6HZabA/3$Ix1PUMpe5IUlJ8pyNI8jp7b/4GvFFCBSFVqQUUYQEaGbElNsrCrqCHdEDKmegLQbEOMET0n.Dog4vPfuBHmQp0"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-rsa  insecure@lerncloud

  storage:
    layout:
      name: direct
      
  # Diese Befehle laufen NOCH VOR dem Reboot am Ende der Installation
  late-commands:
    - |
      curtin in-target --target=/target -- bash -c '
        set -eux
        lspci -nn | grep -qi NVIDIA || exit 0
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl gnupg2 build-essential dkms linux-headers-generic
        rm -f /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
        curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey |
          gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
        curl -sL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list |
          sed "s#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g" >/etc/apt/sources.list.d/nvidia-container-toolkit.list
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y nvidia-driver-610 nvidia-utils-610 nvidia-container-toolkit
        dpkg --configure -a
        dkms autoinstall
        dkms status | grep -qE "nvidia/.+installed"
      '
    - curtin in-target --target=/target -- touch /boot/lernvirt-installed
      
  user-data:
    apt:
      primary:
        - arches: [amd64, i386]
          uri: http://mirror.init7.net/ubuntu  
    users:
      - default
      - name: ubuntu
        sudo: ALL=(ALL) NOPASSWD:ALL
        groups: users, admin 
    disable_root: true
    packages:
      - jq
      - curl
      - git
      - git-lfs
      - wget
      - net-tools
      - nmap      
    runcmd:
      - echo "ubuntu:digicomp" | chpasswd
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/issue-patch.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/nfsshare.sh | bash - 
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/storage-patch.sh | bash -  
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/docker.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/containers.sh | bash -      
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/k3scontrol.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/k3scontroladdons.sh | bash - 
